<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h4 mb-1">Role Permissions</h1>
      <p class="text-muted mb-0"><%= @company&.name %></p>
    </div>
  </div>

  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <%= link_to "General Settings", company_configs_path(tab: "general"), class: "nav-link" %>
    </li>
    <li class="nav-item">
      <%= link_to "Dynamic Lists", company_configs_path(tab: "lists"), class: "nav-link" %>
    </li>
    <li class="nav-item">
      <%= link_to "Permissions", admin_permissions_path, class: "nav-link active" %>
    </li>
  </ul>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
      <%= form_with url: admin_permissions_path, method: :post, local: true do %>
        <div class="table-responsive">
          <table class="table table-bordered align-middle mb-3">
            <thead class="table-light">
              <tr>
                <th style="min-width: 260px;">Permission</th>
                <% Admin::PermissionsController::ROLES.each do |role| %>
                  <th class="text-center text-capitalize"><%= role %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% Admin::PermissionsController::PERMISSIONS.each do |permission_key| %>
                <tr>
                  <td class="fw-semibold"><%= permission_key.humanize %></td>
                  <% Admin::PermissionsController::ROLES.each do |role| %>
                    <% checked = @matrix[[permission_key, role]] == true %>
                    <td class="text-center">
                      <input
                        type="checkbox"
                        class="form-check-input"
                        name="permissions[<%= permission_key %>][<%= role %>]"
                        value="1"
                        <%= "checked" if checked %>
                      >
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">Save Permissions</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
