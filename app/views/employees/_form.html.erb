<%= form_with model: employee, local: true do |f| %>
  <% if employee.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% employee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="mb-3">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :employee_code, class: "form-label" %>
        <%= f.text_field :employee_code, class: "form-control" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :department, class: "form-label" %>
        <%= f.select :department, (@department_options || []).map { |d| [d, d] }, { include_blank: "Select department" }, class: "form-select" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :job_title, class: "form-label" %>
        <%= f.text_field :job_title, class: "form-control" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :payment_method, class: "form-label" %>
        <%= f.select :payment_method, Employee.payment_methods.keys.map { |k| [k.humanize, k] }, {}, class: "form-select", id: 'payment_method_select' %>
      </div>
    </div>
    <div id="bank-fields" class="col-12">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :bank_name, class: "form-label" %>
            <%= f.text_field :bank_name, class: "form-control" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :bank_account_number, class: "form-label" %>
            <%= f.text_field :bank_account_number, class: "form-control" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :bank_branch, class: "form-label" %>
            <%= f.text_field :bank_branch, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :mobile_money_number, class: "form-label" %>
        <%= f.text_field :mobile_money_number, class: "form-control" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :mobile_money_provider, class: "form-label" %>
        <%= f.select :mobile_money_provider, [["Select", ""]] + Employee.mobile_money_providers.keys.map { |k| [k.humanize, k] }, {}, class: "form-select" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :employment_status, class: "form-label" %>
        <%= f.select :employment_status, Employee.employment_statuses.keys.map { |k| [k.humanize, k] }, {}, class: "form-select" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :onboarding_status, class: "form-label" %>
        <%= f.select :onboarding_status, Employee.onboarding_statuses.keys.map { |k| [k.humanize, k] }, {}, class: "form-select" %>
      </div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", employees_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const pmSelect = document.getElementById('payment_method_select')
    const bankFields = document.getElementById('bank-fields')
    const bankName = document.querySelector('input[name="employee[bank_name]"]')
    const bankAccount = document.querySelector('input[name="employee[bank_account_number]"]')

    function toggleBankFields() {
      const val = pmSelect.value
      if (val === 'bank') {
        bankFields.classList.remove('d-none')
        if (bankName) bankName.required = true
        if (bankAccount) bankAccount.required = true
      } else {
        bankFields.classList.add('d-none')
        if (bankName) bankName.required = false
        if (bankAccount) bankAccount.required = false
      }
    }

    if (pmSelect && bankFields) {
      toggleBankFields()
      pmSelect.addEventListener('change', toggleBankFields)
    }
  })
</script>
