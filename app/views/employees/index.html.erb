<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1">Employees</h1>
      <p class="text-muted mb-0">Current employees and payroll eligibility status.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Import Employees", new_import_template_path, class: "btn btn-primary" %>
      <%= link_to "New Employee", new_employee_path, class: "btn btn-outline-primary" %>
    </div>
  </div>

  <div class="card shadow-sm border-0 d-none d-md-block">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Code</th>
              <th>Department</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @employees.each do |employee| %>
              <% status_text, status_badge_class =
                if employee.employment_status_blocked?
                  ["Blocked", "bg-danger-subtle text-danger"]
                elsif employee.onboarding_status_unverified?
                  ["Unverified", "bg-warning-subtle text-warning"]
                else
                  ["Active", "bg-success-subtle text-success"]
                end %>
              <tr>
                <td data-label="Name">
                  <div class="fw-semibold"><%= [employee.first_name, employee.last_name].compact.join(" ").presence || "-" %></div>
                </td>
                <td data-label="Code"><%= employee.employee_code.presence || "-" %></td>
                <td data-label="Department"><%= employee.department.presence || "Unassigned" %></td>
                <td data-label="Status">
                  <span class="badge <%= status_badge_class %>"><%= status_text %></span>
                </td>
                <td data-label="Actions" class="text-end">
                  <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <%= link_to "View", employee_path(employee), class: "btn btn-sm btn-outline-secondary" %>
                    <%= link_to "Edit", edit_employee_path(employee), class: "btn btn-sm btn-outline-primary" %>
                    <% if employee.employment_status_blocked? %>
                      <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#employeeBlockModal-<%= employee.id %>">Unblock</button>
                    <% else %>
                      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#employeeBlockModal-<%= employee.id %>">Block</button>
                    <% end %>
                    <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#employeeDeleteModal-<%= employee.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="d-md-none d-grid gap-3">
    <% @employees.each do |employee| %>
      <% status_text, status_badge_class =
        if employee.employment_status_blocked?
          ["Blocked", "bg-danger-subtle text-danger"]
        elsif employee.onboarding_status_unverified?
          ["Unverified", "bg-warning-subtle text-warning"]
        else
          ["Active", "bg-success-subtle text-success"]
        end %>
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div class="fw-semibold"><%= [employee.first_name, employee.last_name].compact.join(" ").presence || "-" %></div>
            <span class="badge <%= status_badge_class %>"><%= status_text %></span>
          </div>
          <div class="small text-muted mb-1"><strong>Code:</strong> <%= employee.employee_code.presence || "-" %></div>
          <div class="small text-muted mb-3"><strong>Department:</strong> <%= employee.department.presence || "Unassigned" %></div>
          <div class="d-flex flex-wrap gap-2">
            <%= link_to "View", employee_path(employee), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Edit", edit_employee_path(employee), class: "btn btn-sm btn-outline-primary" %>
            <% if employee.employment_status_blocked? %>
              <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#employeeBlockModal-<%= employee.id %>">Unblock</button>
            <% else %>
              <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#employeeBlockModal-<%= employee.id %>">Block</button>
            <% end %>
            <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#employeeDeleteModal-<%= employee.id %>">Delete</button>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% @employees.each do |employee| %>
    <% block_label = employee.employment_status_blocked? ? "Unblock" : "Block" %>
    <% block_path = employee.employment_status_blocked? ? unblock_employee_path(employee) : block_employee_path(employee) %>
    <% block_style = employee.employment_status_blocked? ? "btn-success" : "btn-danger" %>

    <div class="modal fade" id="employeeBlockModal-<%= employee.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><%= block_label %> Employee</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            Are you sure you want to <%= block_label.downcase %> <strong><%= [employee.first_name, employee.last_name].join(" ").strip.presence || employee.employee_code %></strong>?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form_with url: block_path, method: :patch, local: true do %>
              <%= submit_tag "#{block_label} Employee", class: "btn #{block_style}" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="employeeDeleteModal-<%= employee.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delete Employee</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            This action cannot be undone. Delete <strong><%= [employee.first_name, employee.last_name].join(" ").strip.presence || employee.employee_code %></strong>?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form_with url: employee_path(employee), method: :delete, local: true do %>
              <%= submit_tag "Delete Employee", class: "btn btn-danger" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
