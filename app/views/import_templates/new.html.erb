<div class="container py-4">
	<h1 class="mb-3">Employee Import</h1>
	<p class="text-muted">Step 1 of 3: Upload CSV/XLSX file.</p>
	<div class="mb-3">
		<%= link_to "Download Sample Excel", download_sample_import_templates_path, class: "btn btn-outline-secondary" %>
	</div>

	<% if flash[:alert] %>
		<div class="alert alert-danger"><%= flash[:alert] %></div>
	<% end %>

	<%= form_with model: @import_template, url: import_templates_path, local: true, html: { multipart: true, class: "card p-3" } do |f| %>
		<div class="mb-3">
			<%= f.label :name, "Template Name", class: "form-label" %>
			<%= f.text_field :name, class: "form-control", placeholder: "August Payroll Import" %>
		</div>

		<div class="mb-3">
			<%= f.label :file, "Spreadsheet File", class: "form-label" %>
			<%= f.file_field :file, class: "form-control", accept: ".csv,.xlsx,.xls" %>
			<div class="form-text">Supported formats: CSV, XLSX, XLS.</div>
		</div>

		<div>
			<%= f.submit "Upload and Continue", class: "btn btn-primary" %>
		</div>
	<% end %>
</div>
