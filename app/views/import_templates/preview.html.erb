<div class="container py-4">
	<h1 class="mb-2">Employee Import</h1>
	<p class="text-muted">Step 2 and 3 of 3: Preview file, map columns, then import.</p>

	<% if flash[:notice] %>
		<div class="alert alert-success"><%= flash[:notice] %></div>
	<% end %>

	<% if flash[:alert] %>
		<div class="alert alert-danger"><%= flash[:alert] %></div>
	<% end %>

	<div class="mb-3">
		<strong>Template:</strong> <%= @import_template.name.presence || "Untitled" %><br>
		<strong>File:</strong> <%= @import_template.file.filename %>
	</div>

	<%= form_with url: import_import_template_path(@import_template), method: :post, local: true, class: "card p-3 mb-4" do %>
		<h2 class="h5">Column Mapping</h2>
		<p class="text-muted mb-3">Include bank columns in mapping where applicable.</p>

		<div class="table-responsive">
			<table class="table table-sm align-middle responsive-card-table">
				<thead>
					<tr>
						<th>Source Column</th>
						<th>Map To</th>
					</tr>
				</thead>
				<tbody>
					<% @headers.each_with_index do |header, index| %>
						<tr>
							<td data-label="Source Column">
								<strong><%= header.presence || "Column #{index + 1}" %></strong>
							</td>
							<td data-label="Map To">
								<%= select_tag "mapping[#{index}]",
										options_for_select(@mapping_options, @saved_mapping[index.to_s]),
										class: "form-select form-select-sm" %>
							</td>
						</tr>
					<% end %>
				</tbody>
			</table>
		</div>

		<div>
			<%= submit_tag "Import Employees", class: "btn btn-primary" %>
			<%= link_to "Upload Another File", new_import_template_path, class: "btn btn-outline-secondary" %>
		</div>
	<% end %>

	<div class="card p-3">
		<h2 class="h5">Preview (First 5 Data Rows)</h2>
		<div class="table-responsive">
			<table class="table table-bordered table-sm responsive-card-table">
				<thead>
					<tr>
						<% @headers.each do |header| %>
							<th><%= header %></th>
						<% end %>
					</tr>
				</thead>
				<tbody>
					<% @preview_rows.each do |row| %>
						<tr>
							<% @headers.each_with_index do |header, index| %>
								<td data-label="<%= header.presence || "Column #{index + 1}" %>"><%= row[index] %></td>
							<% end %>
						</tr>
					<% end %>
				</tbody>
			</table>
		</div>
	</div>
</div>
