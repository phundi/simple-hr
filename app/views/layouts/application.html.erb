<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hr">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js" defer></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <style>
      :root {
        --company-primary: <%= current_company&.primary_color.presence || "#0d6efd" %>;
      }

      .btn-primary {
        background-color: var(--company-primary);
        border-color: var(--company-primary);
        border-radius: 0.5rem;
      }

      .btn-primary:hover,
      .btn-primary:focus {
        filter: brightness(0.92);
      }

      .app-sidebar {
        background: #212529;
        width: 240px;
      }

      .app-sidebar .nav-link,
      .app-sidebar .offcanvas-title,
      .app-sidebar h5 {
        color: rgba(255, 255, 255, 0.92);
      }

      .app-sidebar .nav-link:hover,
      .app-sidebar .nav-link:focus {
        background: rgba(255, 255, 255, 0.08);
      }

      .app-main {
        background: #f8f9fa;
        min-height: 100vh;
      }

      .card {
        box-shadow: var(--bs-box-shadow-sm);
        border: 0;
        border-radius: 1rem;
      }
    </style>

    <% ga_id = ConfigService.get(current_user, current_company, "google_analytics_id").to_s.strip %>
    <% if ga_id.present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_id %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);} // eslint-disable-line
        gtag('js', new Date());
        gtag('config', '<%= ga_id %>');
      </script>
    <% end %>
  </head>

  <body>
    <div class="d-lg-none sticky-top bg-white border-bottom">
      <div class="container-fluid py-2 d-flex justify-content-between align-items-center">
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar">
          Menu
        </button>
        <div class="fw-semibold d-flex align-items-center gap-2">
          <% if current_company&.logo&.attached? %>
            <%= image_tag current_company.logo, alt: "Company logo", class: "rounded", style: "height: 24px; width: 24px; object-fit: cover;" %>
          <% end %>
          <span><%= current_company&.name.presence || "HR Portal" %></span>
        </div>
        <span class="badge text-bg-light">v1</span>
      </div>
    </div>

    <div class="offcanvas offcanvas-start offcanvas-lg border-end app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
      <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-center gap-2" id="appSidebarLabel">
          <% if current_company&.logo&.attached? %>
            <%= image_tag current_company.logo, alt: "Company logo", class: "rounded", style: "height: 26px; width: 26px; object-fit: cover;" %>
          <% end %>
          <span><%= current_company&.name.presence || "HR Portal" %></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body p-0">
        <nav class="nav nav-pills flex-column gap-1 p-3">
          <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
          <%= link_to "Employees", employees_path, class: "nav-link" %>
          <%= link_to "Users", users_path, class: "nav-link" %>
          <%= link_to "Import", new_import_template_path, class: "nav-link" %>
          <%= link_to "Payroll", payroll_path, class: "nav-link" %>
          <%= link_to "Company Config", company_configs_path, class: "nav-link" %>
          <%= link_to "Settings", settings_path, class: "nav-link" %>

          <% if user_signed_in? %>
            <hr class="border-secondary-subtle my-2">
            <div class="d-flex align-items-center gap-2 px-2 py-1 text-white-50 small">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, alt: "My account avatar", class: "rounded-circle", style: "height: 24px; width: 24px; object-fit: cover;" %>
              <% else %>
                <span class="rounded-circle bg-light text-dark d-inline-flex align-items-center justify-content-center" style="height: 24px; width: 24px;">M</span>
              <% end %>
              <span><%= [current_user.first_name, current_user.last_name].compact.join(" ").presence || current_user.email %></span>
            </div>
            <%= link_to "My Account", account_users_path, class: "nav-link" %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link nav-link text-start p-0 ps-2" %>
          <% end %>
        </nav>
      </div>
    </div>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="d-none d-lg-block border-end min-vh-100 app-sidebar" style="width: 240px; flex: 0 0 240px; max-width: 240px;">
          <div class="p-3">
            <h5 class="mb-3 d-flex align-items-center gap-2">
              <% if current_company&.logo&.attached? %>
                <%= image_tag current_company.logo, alt: "Company logo", class: "rounded", style: "height: 28px; width: 28px; object-fit: cover;" %>
              <% end %>
              <span><%= current_company&.name.presence || "HR Portal" %></span>
            </h5>
            <nav class="nav nav-pills flex-column gap-1">
              <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
              <%= link_to "Employees", employees_path, class: "nav-link" %>
              <%= link_to "Users", users_path, class: "nav-link" %>
              <%= link_to "Import", new_import_template_path, class: "nav-link" %>
              <%= link_to "Payroll", payroll_path, class: "nav-link" %>
              <%= link_to "Company Config", company_configs_path, class: "nav-link" %>
              <%= link_to "Settings", settings_path, class: "nav-link" %>

              <% if user_signed_in? %>
                <hr class="border-secondary-subtle my-2">
                <div class="d-flex align-items-center gap-2 px-2 py-1 text-white-50 small">
                  <% if current_user.avatar.attached? %>
                    <%= image_tag current_user.avatar, alt: "My account avatar", class: "rounded-circle", style: "height: 24px; width: 24px; object-fit: cover;" %>
                  <% else %>
                    <span class="rounded-circle bg-light text-dark d-inline-flex align-items-center justify-content-center" style="height: 24px; width: 24px;">M</span>
                  <% end %>
                  <span><%= [current_user.first_name, current_user.last_name].compact.join(" ").presence || current_user.email %></span>
                </div>
                <%= link_to "My Account", account_users_path, class: "nav-link" %>
                <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link nav-link text-start p-0 ps-2" %>
              <% end %>
            </nav>
          </div>
        </aside>

        <main class="col-12 pb-5 pb-lg-0 app-main" style="flex: 1;">
          <div class="container py-3">
            <% if notice.present? %>
              <div class="alert alert-success" role="alert"><%= notice %></div>
            <% end %>
            <% if alert.present? %>
              <div class="alert alert-danger" role="alert"><%= alert %></div>
            <% end %>
          </div>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav class="navbar fixed-bottom bg-white border-top d-lg-none">
      <div class="container-fluid px-2">
        <div class="d-flex justify-content-around w-100">
          <%= link_to "Dashboard", dashboard_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Employees", employees_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Users", users_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Import", new_import_template_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Payroll", payroll_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Company Config", company_configs_path, class: "btn btn-link text-decoration-none small" %>
          <%= link_to "Settings", settings_path, class: "btn btn-link text-decoration-none small" %>
          <% if user_signed_in? %>
            <%= link_to "My Account", account_users_path, class: "btn btn-link text-decoration-none small" %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link text-decoration-none small" %>
          <% end %>
        </div>
      </div>
    </nav>

    <script>
      document.addEventListener("turbo:load", function () {
        document.querySelectorAll("table").forEach(function (table) {
          table.classList.add("responsive-card-table");

          var headers = Array.from(table.querySelectorAll("thead th")).map(function (th) {
            return th.textContent.trim();
          });

          if (!headers.length) return;

          table.querySelectorAll("tbody tr").forEach(function (row) {
            Array.from(row.children).forEach(function (cell, index) {
              if (!cell.hasAttribute("data-label")) {
                cell.setAttribute("data-label", headers[index] || ("Column " + (index + 1)));
              }
            });
          });
        });
      });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
