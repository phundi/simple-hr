<!DOCTYPE html>
<html lang="en">
  <head>
    <title>PayslipPro</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Favicon with cache busting -->
    <%= favicon_link_tag "favicon.ico?v=2" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hr">
    <meta name="mobile-web-app-capable" content="yes">

    <%= yield :head %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@latest/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>

    <style>
      :root {
        --tblr-primary: <%= current_company&.primary_color.presence || "#0d6efd" %>;
      }

      .company-brand-logo {
        height: 30px;
        width: 30px;
        object-fit: cover;
      }

      .user-avatar-img {
        height: 32px;
        width: 32px;
        object-fit: cover;
      }
    </style>

    <% ga_id = ConfigService.get(current_user, current_company, "google_analytics_id").to_s.strip %>
    <% if ga_id.present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_id %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);} // eslint-disable-line
        gtag("js", new Date());
        gtag("config", "<%= ga_id %>");
      </script>
    <% end %>
  </head>

  <body class="layout-fluid">
    <div class="page">
      <% if user_signed_in? %>
        <%= render "shared/navbar" %>
      <% end %>

      <div class="page-wrapper">
        <div class="page-body">
          <div class="container-xl <%= user_signed_in? ? "" : "py-4" %>">
            <% if user_signed_in? %>
              <div class="row mb-2">
                <div class="col-12">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-arrows">
                      <li class="breadcrumb-item"><%= link_to "Home", authenticated_root_path %></li>
                      <li class="breadcrumb-item"><%= controller_name.humanize %></li>
                      <li class="breadcrumb-item active" aria-current="page"><%= action_name.humanize %></li>
                    </ol>
                  </nav>
                </div>
              </div>
            <% end %>

            <% if notice.present? %>
              <div class="alert alert-success" role="alert"><%= notice %></div>
            <% end %>
            <% if alert.present? %>
              <div class="alert alert-danger" role="alert"><%= alert %></div>
            <% end %>

            <%= yield %>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@tabler/core@latest/dist/js/tabler.min.js"></script>
    <script>
      function initializeThemeToggle() {
        var html = document.documentElement;
        var savedTheme = localStorage.getItem("tablerTheme") || "light";
        var activeTheme = savedTheme === "dark" ? "dark" : "light";
        html.setAttribute("data-bs-theme", activeTheme);

        var toggle = document.getElementById("theme-toggle");
        var icon = document.getElementById("theme-toggle-icon");
        if (!toggle) {
          return;
        }

        var setIcon = function () {
          if (!icon) {
            return;
          }

          var mode = html.getAttribute("data-bs-theme") === "dark" ? "dark" : "light";
          icon.className = mode === "dark" ? "ti ti-sun" : "ti ti-moon";
        };

        setIcon();

        if (toggle.dataset.themeBound === "true") {
          return;
        }

        toggle.dataset.themeBound = "true";
        toggle.addEventListener("click", function () {
          var newTheme = html.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
          html.setAttribute("data-bs-theme", newTheme);
          localStorage.setItem("tablerTheme", newTheme);
          setIcon();
        });
      }

      document.addEventListener("DOMContentLoaded", initializeThemeToggle);
      document.addEventListener("turbo:load", initializeThemeToggle);
    </script>
  </body>
</html>
