<div class="container py-4" style="max-width: 860px;">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h1 class="h3 mb-2">Employee Verification</h1>
      <p class="text-muted mb-4">Confirm your profile and update bank details to complete onboarding.</p>

      <% if flash[:notice].present? %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: onboarding_path(token: params[:token]), method: :patch, local: true do %>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <%= label_tag "user_first_name", "First Name", class: "form-label" %>
            <%= text_field_tag "user[first_name]", @user.first_name, class: "form-control #{'is-invalid' if @user.errors[:first_name].any?}" %>
            <% @user.errors[:first_name].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "user_last_name", "Last Name", class: "form-label" %>
            <%= text_field_tag "user[last_name]", @user.last_name, class: "form-control #{'is-invalid' if @user.errors[:last_name].any?}" %>
            <% @user.errors[:last_name].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "user_phone_number", "Phone Number", class: "form-label" %>
            <%= telephone_field_tag "user[phone_number]", @user.phone_number, class: "form-control" %>
          </div>

          <div class="col-md-6">
            <%= label_tag "user_email", "Email", class: "form-label" %>
            <%= email_field_tag "user[email]", @user.email, class: "form-control", disabled: true %>
          </div>

          <% if @user.company.pro? %>
            <div class="col-md-6">
              <div class="form-check mt-4">
                <%= hidden_field_tag "user[two_factor_enabled]", 0 %>
                <%= check_box_tag "user[two_factor_enabled]", 1, @user.two_factor_enabled, class: "form-check-input" %>
                <%= label_tag "user_two_factor_enabled", "Enable two-factor authentication", class: "form-check-label" %>
              </div>
              <% @user.errors[:two_factor_enabled].each do |message| %>
                <div class="text-danger small mt-1"><%= message %></div>
              <% end %>
            </div>

            <div class="col-md-6">
              <%= label_tag "user_two_factor_method", "Two-Factor Method", class: "form-label" %>
              <%= select_tag "user[two_factor_method]", options_for_select([["Select", ""], ["WhatsApp OTP", "whatsapp_otp"], ["Authenticator", "authenticator"]], @user.two_factor_method), class: "form-select #{'is-invalid' if @user.errors[:two_factor_method].any?}" %>
              <% @user.errors[:two_factor_method].each do |message| %>
                <div class="invalid-feedback d-block"><%= message %></div>
              <% end %>
            </div>
          <% end %>
        </div>

        <hr class="my-4" />

        <h2 class="h5 mb-3">Bank Details</h2>

        <div class="row g-3">
          <div class="col-md-6">
            <%= label_tag "employee_payment_method", "Payment Method", class: "form-label" %>
            <%= select_tag "employee[payment_method]", options_for_select([["Bank", "bank"], ["Mobile Money", "mobile_money"], ["Cash", "cash"]], @employee.payment_method), class: "form-select #{'is-invalid' if @employee.errors[:payment_method].any?}" %>
            <% @employee.errors[:payment_method].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_account_holder_name", "Account Holder Name", class: "form-label" %>
            <%= text_field_tag "employee[account_holder_name]", @employee.account_holder_name, class: "form-control" %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_bank_name", "Bank Name", class: "form-label" %>
            <%= text_field_tag "employee[bank_name]", @employee.bank_name, class: "form-control #{'is-invalid' if @employee.errors[:bank_name].any?}" %>
            <% @employee.errors[:bank_name].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_bank_branch", "Bank Branch", class: "form-label" %>
            <%= text_field_tag "employee[bank_branch]", @employee.bank_branch, class: "form-control" %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_bank_account_number", "Bank Account Number", class: "form-label" %>
            <%= text_field_tag "employee[bank_account_number]", @employee.bank_account_number, class: "form-control #{'is-invalid' if @employee.errors[:bank_account_number].any?}" %>
            <% @employee.errors[:bank_account_number].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_account_type", "Account Type", class: "form-label" %>
            <%= select_tag "employee[account_type]", options_for_select([["Select", ""], ["Savings", "savings"], ["Checking", "checking"]], @employee.account_type), class: "form-select" %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_mobile_money_number", "Mobile Money Number", class: "form-label" %>
            <%= text_field_tag "employee[mobile_money_number]", @employee.mobile_money_number, class: "form-control #{'is-invalid' if @employee.errors[:mobile_money_number].any?}" %>
            <% @employee.errors[:mobile_money_number].each do |message| %>
              <div class="invalid-feedback d-block"><%= message %></div>
            <% end %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_mobile_money_provider", "Mobile Money Provider", class: "form-label" %>
            <%= select_tag "employee[mobile_money_provider]", options_for_select([["Select", ""], ["Airtel", "airtel"], ["Tigo", "tigo"]], @employee.mobile_money_provider), class: "form-select" %>
          </div>

          <div class="col-md-6">
            <%= label_tag "employee_swift_code", "SWIFT Code", class: "form-label" %>
            <%= text_field_tag "employee[swift_code]", @employee.swift_code, class: "form-control" %>
          </div>
        </div>

        <div class="d-grid d-md-flex justify-content-md-end mt-4">
          <%= submit_tag "Verify and Save", class: "btn btn-primary px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
