<div class="container py-4">
  <div class="d-flex align-items-center mb-4">
    <div>
      <a href="<%= payroll_path %>" class="btn btn-outline-secondary btn-sm me-2">Back</a>
      <h2 class="mb-0">Pay Periods</h2>
      <div class="text-muted small"><%= current_company.name %></div>
    </div>
    <div class="ms-auto">
      <%= link_to 'New Pay Period', new_pay_period_path, class: 'btn btn-primary' if can_render?("create_payroll") %>
    </div>
  </div>

  <% if @pay_periods.empty? %>
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body text-center">
        <h5 class="mb-2">No pay periods yet</h5>
        <p class="text-muted">Create a pay period to start running payroll for your employees.</p>
        <%= link_to 'Create Pay Period', new_pay_period_path, class: 'btn btn-primary' %>
      </div>
    </div>
  <% else %>
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-vcenter card-table mb-0">
            <thead class="thead-light sticky-top">
              <tr>
                <th>S No</th>
                <th>Month</th>
                <th>Year</th>
                <th>Status</th>
                <th>Total Gross</th>
                <th>Total Net</th>
                <th>Employees</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @pay_periods.each_with_index do |pp, idx| %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= Date::MONTHNAMES[pp.month] %></td>
                  <td><%= pp.year %></td>
                  <td><span class="badge <%= pp.published? ? 'bg-success' : 'bg-secondary' %>"><%= pp.status %></span></td>
                  <td><%= money(pp.total_gross || pp.payslips.sum(:gross)) %></td>
                  <td><%= money(pp.total_net || pp.payslips.sum(:net)) %></td>
                  <td><%= pp.payslips.count %></td>
                  <td>
                    <%= link_to 'View', pay_period_path(pp), class: 'btn btn-sm btn-outline-primary' %>
                    <% if can_render?("process_payroll") && pp.draft? %>
                      <%= button_to 'Publish', publish_pay_period_path(pp), method: :post, class: 'btn btn-sm btn-success' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
