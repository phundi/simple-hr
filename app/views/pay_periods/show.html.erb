<div class="container py-4">
  <div class="d-flex align-items-center mb-3">
    <div>
      <%= link_to 'Back', pay_periods_path, class: 'btn btn-outline-secondary btn-sm me-2' %>
      <h3 class="mb-0">Payroll — <%= Date::MONTHNAMES[@pay_period.month] %> <%= @pay_period.year %></h3>
      <div class="text-muted small"><%= current_company.name %></div>
    </div>
    <div class="ms-3"><span class="badge <%= @pay_period.published? ? 'bg-success' : 'bg-secondary' %>"><%= @pay_period.status %></span></div>
    <div class="ms-auto d-flex gap-2">
      <% if can_render?("edit_payroll") %>
        <%= link_to 'Edit All', edit_pay_period_path(@pay_period), class: 'btn btn-outline-secondary' %>
      <% end %>
      <% if can_render?("process_payroll") && @pay_period.draft? %>
        <%= button_to 'Publish Payroll', publish_pay_period_path(@pay_period), method: :post, class: 'btn btn-success' %>
      <% end %>
      <% if can_render?("export_bank_schedule") %>
        <%= link_to 'Export Bank Schedule', export_bank_schedule_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_paye_schedule") %>
        <%= link_to 'Export PAYE List', export_paye_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_pension_list") %>
        <%= link_to 'Export Pension List', export_pension_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_tevet") %>
        <%= link_to 'Export Tevet Levy', export_tevet_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_funeral") %>
        <%= link_to 'Export Funeral Cover', export_funeral_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_medical") %>
        <%= link_to 'Export Medical', export_medical_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_deductions") %>
        <%= link_to 'Export Deductions', export_deductions_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
      <% if can_render?("export_journal_entries") %>
        <%= link_to 'Export Journal Entries', export_journal_pay_period_path(@pay_period), class: 'btn btn-outline-primary' %>
      <% end %>
    </div>
  </div>

  <ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'overview' %>" href="?tab=overview">Overview</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'paye' %>" href="?tab=paye">PAYE List</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'pension' %>" href="?tab=pension">Pension List</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'funeral' %>" href="?tab=funeral">Funeral Cover</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'tevet' %>" href="?tab=tevet">Tevet Levy</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'medical' %>" href="?tab=medical">Medical</a></li>
    <li class="nav-item"><a class="nav-link <%= 'active' if @tab == 'journal' %>" href="?tab=journal">Journal Entries</a></li>
  </ul>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
      <div class="table-responsive">
      <% if @tab == 'overview' %>
        <table class="table table-vcenter card-table mb-0">
          <thead class="sticky-top bg-light">
            <tr>
              <th>S No</th>
              <th>Name</th>
              <th>Position</th>
              <th>Project</th>
              <th class="text-end">Basic Salary</th>
              <th class="text-end">House (10%)</th>
              <th class="text-end">Other Allowances</th>
              <th class="text-end">Gross Income</th>
              <th class="text-end">Medical</th>
              <th class="text-end">Pension Employer</th>
              <th class="text-end">Funeral</th>
              <th class="text-end">Tevet</th>
              <th class="text-end">Life</th>
              <th class="text-end">Admin</th>
              <th class="text-end">VAT</th>
              <th class="text-end">Total Benefits</th>
              <th class="text-end">Total Remuneration</th>
              <th class="text-end">PAYE</th>
              <th class="text-end">Pension Employee</th>
              <th class="text-end">Advance</th>
              <th class="text-end">Total Deductions</th>
              <th class="text-end">Net Pay</th>
            </tr>
          </thead>
          <tbody>
            <% total = Hash.new(0.0) %>
            <% @payslips.each_with_index do |ps, idx| %>
              <% comp = ps.respond_to?(:employer_benefits) ? ps.employer_benefits || {} : {} %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><%= ps.employee.full_name %></td>
                <td><%= ps.employee.job_title %></td>
                <td><%= ps.employee.department %></td>
                <td class="text-end"><%= money(ps.basic_salary || ps.gross) %></td>
                <td class="text-end"><%= money(comp['house_allowance'] || comp[:house_allowance]) %></td>
                <td class="text-end"><%= money((ps.allowances || {}).values.sum) %></td>
                <td class="text-end"><%= money(ps.gross) %></td>
                <td class="text-end"><%= money(comp['medical'] || comp[:medical]) %></td>
                <td class="text-end"><%= money(comp['pension_employer'] || comp[:pension_employer]) %></td>
                <td class="text-end"><%= money(comp['funeral'] || comp[:funeral]) %></td>
                <td class="text-end"><%= money(comp['tevet'] || comp[:tevet]) %></td>
                <td class="text-end"><%= money(comp['life_assurance'] || comp[:life_assurance]) %></td>
                <td class="text-end"><%= money(comp['pension_admin'] || comp[:pension_admin]) %></td>
                <td class="text-end"><%= money(comp['pension_admin_vat'] || comp[:pension_admin_vat]) %></td>
                <td class="text-end"><%= money(ps.total_employer_benefits || comp.values.sum) %></td>
                <td class="text-end"><%= money(ps.total_remuneration || (ps.gross.to_f + (ps.total_employer_benefits || 0).to_f)) %></td>
                <td class="text-end"><%= money(ps.paye || (ps.deductions || 0).to_f) %></td>
                <td class="text-end"><%= money(ps.pension_employee || (ps.deductions || 0).to_f) %></td>
                <td class="text-end"><%= money((ps.deductions_breakdown || {})['advances'] || 0) %></td>
                <td class="text-end"><%= money(ps.deductions || 0) %></td>
                <td class="text-end"><%= money(ps.net) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>Tab content for <%= @tab %> (placeholder)</p>
      <% end %>
    </div>
  </div>
</div>
