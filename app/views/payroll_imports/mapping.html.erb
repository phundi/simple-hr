<div class="container py-4">
  <div class="d-flex align-items-center mb-4">
    <%= link_to 'Back', new_payroll_import_path, class: 'btn btn-outline-secondary btn-sm me-2' %>
    <h2 class="mb-0">Map Columns</h2>
  </div>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
      <h5 class="card-title">Column Mapping</h5>
      <p class="text-muted">Map spreadsheet columns to system fields to prepare import.</p>
      <div class="table-responsive">
        <table class="table table-vcenter card-table mb-0">
          <thead>
            <tr><th>Column</th><th>Preview</th><th>Map To</th></tr>
          </thead>
          <tbody>
            <% @headers.each_with_index do |h, idx| %>
              <tr>
                <td><%= h %></td>
                <td><%= @rows.first[h] rescue '' %></td>
                <td>
                  <select class="form-select form-select-sm">
                    <% @mapping_options.each do |label, value| %>
                      <option value="<%= value %>"><%= label %></option>
                    <% end %>
                  </select>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3 text-end">
        <%= link_to 'Preview', preview_payroll_imports_path, class: 'btn btn-primary' %>
      </div>
    </div>
  </div>
</div>
