<div class="container py-4">
  <div class="d-flex align-items-center mb-4">
    <%= link_to 'Back', company_dashboard_path, class: 'btn btn-outline-secondary btn-sm me-2' %>
    <h2 class="mb-0">Import Payroll</h2>
  </div>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
      <h5 class="card-title">Upload Spreadsheet</h5>
      <%= form_with url: payroll_imports_path, local: true, multipart: true do |f| %>
        <div class="row g-3">
          <div class="col-md-8">
            <%= f.file_field :file, class: 'form-control' %>
          </div>
          <div class="col-md-4 text-end">
            <%= f.submit 'Upload', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
      <div class="mt-3">
        <%= link_to 'Download Template', download_template_payroll_imports_path, class: 'btn btn-outline-secondary' %>
      </div>
    </div>
  </div>
</div>
