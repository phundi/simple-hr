<div class="container py-4">
  <div class="d-flex align-items-center mb-4">
    <%= link_to 'Back', mapping_payroll_imports_path, class: 'btn btn-outline-secondary btn-sm me-2' %>
    <h2 class="mb-0">Preview Import</h2>
  </div>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
      <h5 class="card-title">Import Preview</h5>
      <div class="table-responsive">
        <table class="table table-vcenter card-table mb-0">
          <thead>
            <tr>
              <% (@preview.first || {}).each_key do |k| %>
                <th><%= k.to_s.humanize %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @preview.each do |row| %>
              <tr>
                <% row.each_value do |v| %>
                  <td><%= v %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-3 d-flex justify-content-between">
        <div class="text-muted">Totals: Gross <%= money(@totals[:gross]) %> • Net <%= money(@totals[:net]) %></div>
        <div>
          <%= link_to 'Import', import_payroll_imports_path, method: :post, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>
</div>
