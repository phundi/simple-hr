<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">User Details</h1>
    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_user_path(@user), class: "btn btn-outline-primary" %>
      <%= link_to "Back", users_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <p><strong>Name:</strong> <%= [@user.first_name, @user.last_name].join(" ") %></p>
      <p><strong>Email:</strong> <%= @user.email %></p>
      <p><strong>Role:</strong> <%= @user.role.humanize %></p>
      <p class="mb-0"><strong>Status:</strong> <%= @user.status.humanize %></p>
    </div>
  </div>
</div>
