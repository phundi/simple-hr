82:             </div>
83:           </div>
84:           <div class="col-md-4">
85:             <%= f.label :language, class: "form-label" %>
86:             <%= f.select :language, [["English", "en"], ["French", "fr"], ["Swahili", "sw"]], { selected: @preferences[:language].presence || "en" }, class: "form-select" %>
87:           </div>
88:           <div class="col-12">
89:             <%= f.submit "Save Preferences", class: "btn btn-primary rounded-2" %>
90:           </div>
91:         <% end %>
92:       <% end %>
93:     </div>
94:   </div>
95: </div>
