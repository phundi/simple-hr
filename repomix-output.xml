28:             <%= f.label :last_name %>
29:           </div>
30:           <div class="col-md-6 form-floating">
31:             <%= f.text_field :phone_number, class: "form-control", placeholder: "Phone" %>
32:             <%= f.label :phone_number, "Phone" %>
33:           </div>
34:           <div class="col-12">
35:             <%= f.submit "Save Profile", class: "btn btn-primary rounded-2" %>
36:           </div>
37:         <% end %>
38:       <% elsif active_tab == "security" %>
39:         <%= form_with model: @account_user, url: update_account_users_path(tab: "security"), method: :patch, local: true, class: "row g-3" do |f| %>
40:           <div class="col-md-6 form-floating">
41:             <%= f.password_field :password, class: "form-control", placeholder: "New password", autocomplete: "new-password" %>
42:             <%= f.label :password, "New Password" %>
