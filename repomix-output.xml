188: 											<td class="text-center">
189: 												<input type="checkbox" class="form-check-input" name="permissions[<%= permission_key %>][<%= role %>]" value="1" <%= "checked" if checked %>>
190: 											</td>
191: 										<% end %>
192: 									</tr>
