 49:       <script>
 50:         window.dataLayer = window.dataLayer || [];
 51:         function gtag(){dataLayer.push(arguments);} // eslint-disable-line
 52:         gtag("js", new Date());
 53:         gtag("config", "<%= ga_id %>");
 54:       </script>
 55:     <% end %>
 56:   </head>
 57: 
 58:   <body class="layout-fluid">
 59:     <div class="page">
 60:       <% if user_signed_in? %>
 61:         <%= render "shared/navbar" %>
 62:       <% end %>
 63: 
