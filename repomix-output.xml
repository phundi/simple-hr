44:           <div class="col-md-6 form-floating">
45:             <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm password", autocomplete: "new-password" %>
46:             <%= f.label :password_confirmation, "Confirm Password" %>
47:           </div>
48: 
49:           <% if @enable_2fa %>
50:             <div class="col-12">
51:               <div class="form-check form-switch">
52:                 <%= f.check_box :two_factor_enabled, class: "form-check-input" %>
53:                 <%= f.label :two_factor_enabled, "Yes / No - Enable 2FA", class: "form-check-label" %>
54:               </div>
55:             </div>
56:             <div class="col-md-6">
57:               <%= f.label :two_factor_method, class: "form-label" %>
58:               <%= f.select :two_factor_method, User.two_factor_methods.keys.map { |k| [k.humanize, k] }, { include_blank: "Select method" }, class: "form-select" %>
59:             </div>
60:           <% else %>
61:             <div class="col-12">
62:               <div class="alert alert-info mb-0">2FA is disabled by system configuration.</div>
63:             </div>
64:           <% end %>
65: 
66:           <div class="col-12">
67:             <%= f.submit "Save Security", class: "btn btn-primary rounded-2" %>
68:           </div>
69:         <% end %>
70:       <% else %>
71:         <%= form_with url: update_account_users_path(tab: "preferences"), method: :patch, scope: :preferences, local: true, class: "row g-3" do |f| %>
72:           <div class="col-md-4">
73:             <div class="form-check form-switch">
74:               <%= f.check_box :email_notifications, { class: "form-check-input", checked: ActiveModel::Type::Boolean.new.cast(@preferences[:email_notifications]) }, "true", "false" %>
75:               <%= f.label :email_notifications, "Yes / No - Email notifications", class: "form-check-label" %>
76:             </div>
77:           </div>
78:           <div class="col-md-4">
79:             <div class="form-check form-switch">
80:               <%= f.check_box :whatsapp_notifications, { class: "form-check-input", checked: ActiveModel::Type::Boolean.new.cast(@preferences[:whatsapp_notifications]) }, "true", "false" %>
