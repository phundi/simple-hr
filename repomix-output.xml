<file path="app/models/user.rb">
 1: class User < ApplicationRecord
 2:   devise :database_authenticatable, :recoverable, :rememberable, :validatable
 3: 
 4:   alias_attribute :two_factor, :two_factor_enabled
 5: 
 6:   has_one_attached :avatar
 7: 
 8:   belongs_to :company, optional: true
 9:   has_one :employee, dependent: :nullify
10:   has_many :created_import_templates, class_name: "ImportTemplate", foreign_key: :created_by, inverse_of: :creator, dependent: :nullify
11:   has_many :user_configs, dependent: :destroy
12:   has_many :role_permissions, through: :company
13: 
14:   validates :first_name, presence: true
15:   validates :last_name, presence: true
16:   validates :two_factor_method, presence: true, if: :two_factor_enabled?
17:   validate :two_factor_requires_pro_plan
18: 
19:   enum :role, {
20:     admin: 0,
21:     hr: 1,
22:     accountant: 2
23:   }
24:   enum :status, { active: 0, blocked: 1, invited: 2 }, prefix: true
25:   enum :onboarding_status, { unverified: 0, verified: 1 }, prefix: true
26:   enum :two_factor_method, { whatsapp_otp: "whatsapp_otp", authenticator: "authenticator" }, prefix: true
27: 
28:   scope :available_for_login, -> { status_active }
29: 
30:   def block!(reason: nil)
31:     update!(status: :blocked, blocked_at: Time.current, blocked_reason: reason)
32:   end
33: 
34:   def unblock!
35:     update!(status: :active, blocked_at: nil, blocked_reason: nil)
36:   end
37: 
38:   def active_for_authentication?
39:     super && status_active?
40:   end
41: 
42:   def inactive_message
43:     return :blocked unless status_active?
44: 
45:     super
46:   end
47: 
48:   def send_verification!
49:     update!(verification_token: SecureRandom.hex(16), verification_sent_at: Time.current)
50:   end
51: 
52:   def preference(key, fallback: nil)
53:     user_configs.find_by(key: key)&.value || fallback
54:   end
55: 
56:   def full_name
57:     [ first_name, last_name ].compact.join(" ").strip
58:   end
59: 
60:   def can_access_super_admin?
61:     super_admin?
62:   end
63: 
64:   def can?(permission_key)
65:     return true if super_admin?
66:     return false if company_id.blank? || role.blank? || permission_key.blank?
67: 
68:     RolePermission.exists?(
69:       company_id: company_id,
70:       role: role,
71:       permission_key: permission_key.to_s,
72:       enabled: true
73:     )
74:   end
75: 
76:   private
77: 
78:   def two_factor_requires_pro_plan
79:     return unless two_factor_enabled?
80:     return if company&.pro?
81: 
82:     errors.add(:two_factor_enabled, "is available on the pro plan only")
83:   end
84: end
</file>

