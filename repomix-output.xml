156: 								<% (@property_groups[key] || []).each do |prop| %>
157: 									<span class="badge rounded-pill text-bg-light d-inline-flex align-items-center gap-2 px-3 py-2">
158: 										<span><%= prop.value %></span>
159: 										<%= button_to "x", destroy_property_company_configs_path(id: prop.id), method: :delete, form: { class: "d-inline" }, class: "btn btn-sm btn-link text-danger text-decoration-none p-0", data: { turbo_confirm: "Remove this item?" } %>
160: 									</span>
161: 								<% end %>
162: 							</div>
163: 						</div>
164: 					</div>
165: 				</div>
166: 			<% end %>
167: 		</div>
168: 	<% else %>
169: 		<div class="card shadow-sm border-0 rounded-3">
170: 			<div class="card-body">
171: 				<%= form_with url: update_permissions_company_configs_path, method: :post, local: true do %>
172: 					<div class="table-responsive">
