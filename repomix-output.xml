<file path="app/views/companies/wizard/_step1.html.erb">
  1: <%= form_with url: companies_path(step: 1), method: :post, class: "row g-3", data: { suggest_url: suggest_subdomain_companies_path } do %>
  2:   <div class="col-12">
  3:     <label for="company_name" class="form-label">Company name</label>
  4:     <%= text_field_tag "company[name]", wizard_name, id: "company_name", class: "form-control", placeholder: "Acme Ltd", required: true, autocomplete: "organization" %>
  5:   </div>
  6: 
  7:   <div class="col-12">
  8:     <label for="company_subdomain" class="form-label">Subdomain</label>
  9:     <div class="input-group">
 10:       <span class="input-group-text">https://</span>
 11:       <%= text_field_tag "company[subdomain]", wizard_subdomain, id: "company_subdomain", class: "form-control", placeholder: "acme", required: true, pattern: "[a-z0-9-]+", aria: { describedby: "subdomain_help" } %>
 12:       <span class="input-group-text">.</span>
 13:       <span class="input-group-text"><%= main_domain %></span>
 14:     </div>
 15:     <div id="subdomain_help" class="form-text">Use lowercase letters, numbers, and hyphens only.</div>
 16:   </div>
 17: 
 18:   <% if suggestions.present? %>
 19:     <div class="col-12">
 20:       <div class="small text-muted mb-2 d-flex align-items-center justify-content-between">
 21:         <span>Suggestions:</span>
 22:         <span id="subdomain_suggestion_status" class="small"></span>
 23:       </div>
 24:       <div class="d-flex flex-wrap gap-2" data-suggestion-container>
 25:         <% suggestions.each do |candidate| %>
 26:           <button type="button" class="btn btn-outline-secondary btn-sm" data-subdomain-suggestion="<%= candidate %>"><%= candidate %></button>
 27:         <% end %>
 28:       </div>
 29:     </div>
 30:   <% else %>
 31:     <div class="col-12">
 32:       <div class="small text-muted mb-2 d-flex align-items-center justify-content-between">
 33:         <span>Suggestions:</span>
 34:         <span id="subdomain_suggestion_status" class="small"></span>
 35:       </div>
 36:       <div class="d-flex flex-wrap gap-2" data-suggestion-container></div>
 37:     </div>
 38:   <% end %>
 39: 
 40:   <div class="col-12 d-flex justify-content-end">
 41:     <%= submit_tag "Continue", class: "btn btn-primary" %>
 42:   </div>
 43: <% end %>
 44: 
 45: <script>
 46:   document.addEventListener("turbo:load", function () {
 47:     var nameInput = document.getElementById("company_name");
 48:     var subdomainInput = document.getElementById("company_subdomain");
 49:     var form = nameInput && nameInput.closest("form");
 50:     var status = document.getElementById("subdomain_suggestion_status");
 51:     if (!nameInput || !subdomainInput || !form) return;
 52: 
 53:     function bindSuggestionButtons() {
 54:       document.querySelectorAll("[data-subdomain-suggestion]").forEach(function (button) {
 55:         button.addEventListener("click", function () {
 56:           subdomainInput.value = button.dataset.subdomainSuggestion;
 57:         });
 58:       });
 59:     }
 60: 
 61:     bindSuggestionButtons();
 62: 
 63:     var debounceTimer;
 64:     nameInput.addEventListener("input", function () {
 65:       clearTimeout(debounceTimer);
 66:       debounceTimer = setTimeout(function () {
 67:         var suggestUrl = form.dataset.suggestUrl;
 68:         var name = nameInput.value.trim();
 69:         if (!suggestUrl || name.length < 2) {
 70:           if (status) status.textContent = "";
 71:           return;
 72:         }
 73: 
 74:         if (status) status.textContent = "Checking...";
 75: 
 76:         fetch(suggestUrl + "?name=" + encodeURIComponent(name), {
 77:           headers: { "Accept": "application/json" }
 78:         })
 79:           .then(function (response) { return response.json(); })
 80:           .then(function (data) {
 81:             var container = document.querySelector("[data-suggestion-container]");
 82:             if (!container) return;
 83: 
 84:             container.innerHTML = "";
 85: 
 86:             var suggestions = data.suggestions || [];
 87:             suggestions.forEach(function (candidate) {
 88:               var btn = document.createElement("button");
 89:               btn.type = "button";
 90:               btn.className = "btn btn-outline-secondary btn-sm";
 91:               btn.dataset.subdomainSuggestion = candidate;
 92:               btn.textContent = candidate;
 93:               btn.addEventListener("click", function () {
 94:                 subdomainInput.value = candidate;
 95:               });
 96:               container.appendChild(btn);
 97:             });
 98: 
 99:             if (status) {
100:               status.textContent = suggestions.length ? "Tap to select" : "No suggestions";
101:             }
102:           })
103:           .catch(function () {
104:             if (status) status.textContent = "Could not fetch suggestions";
105:           });
106:       }, 300);
107:     });
108:   });
109: </script>
</file>

