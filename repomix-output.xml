 73:                       <li class="breadcrumb-item"><%= controller_name.humanize %></li>
 74:                       <li class="breadcrumb-item active" aria-current="page"><%= action_name.humanize %></li>
 75:                     </ol>
 76:                   </nav>
 77:                 </div>
 78:               </div>
 79:             <% end %>
 80: 
 81:             <% if notice.present? %>
 82:               <div class="alert alert-success" role="alert"><%= notice %></div>
 83:             <% end %>
 84:             <% if alert.present? %>
 85:               <div class="alert alert-danger" role="alert"><%= alert %></div>
 86:             <% end %>
 87: 
 88:             <%= yield %>
 89:           </div>
 90:         </div>
 91:       </div>
 92:     </div>
 93: 
 94:     <script src="https://cdn.jsdelivr.net/npm/@tabler/core@latest/dist/js/tabler.min.js"></script>
 95:     <script>
 96:       function initializeThemeToggle() {
 97:         var html = document.documentElement;
 98:         var savedTheme = localStorage.getItem("tablerTheme") || "light";
 99:         var activeTheme = savedTheme === "dark" ? "dark" : "light";
100:         html.setAttribute("data-bs-theme", activeTheme);
101: 
102:         var toggle = document.getElementById("theme-toggle");
103:         var icon = document.getElementById("theme-toggle-icon");
104:         if (!toggle) {
105:           return;
106:         }
107: 
108:         var setIcon = function () {
109:           if (!icon) {
110:             return;
111:           }
112: 
113:           var mode = html.getAttribute("data-bs-theme") === "dark" ? "dark" : "light";
114:           icon.className = mode === "dark" ? "ti ti-sun" : "ti ti-moon";
115:         };
116: 
117:         setIcon();
118: 
119:         if (toggle.dataset.themeBound === "true") {
120:           return;
121:         }
122: 
123:         toggle.dataset.themeBound = "true";
124:         toggle.addEventListener("click", function () {
125:           var newTheme = html.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
126:           html.setAttribute("data-bs-theme", newTheme);
127:           localStorage.setItem("tablerTheme", newTheme);
128:           setIcon();
129:         });
130:       }
131: 
132:       document.addEventListener("DOMContentLoaded", initializeThemeToggle);
133:       document.addEventListener("turbo:load", initializeThemeToggle);
134:     </script>
135:   </body>
136: </html>
</file>

