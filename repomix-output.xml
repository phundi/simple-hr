<file path="app/services/employee_import_service.rb">
  1: class EmployeeImportService
  2:   EMPLOYEE_FIELDS = %w[
  3:     first_name
  4:     last_name
  5:     employee_code
  6:     department
  7:     job_title
  8:     salary
  9:     payment_method
 10:     bank_name
 11:     bank_branch
 12:     bank_account_number
 13:     account_type
 14:     account_holder_name
 15:     swift_code
 16:     mobile_money_number
 17:     mobile_money_provider
 18:   ].freeze
 19: 
 20:   USER_FIELDS = %w[email phone_number].freeze
 21: 
 22:   def initialize(company:, import_template:, actor: nil)
 23:     @company = company
 24:     @import_template = import_template
 25:     @actor = actor
 26:   end
 27: 
 28:   def call(rows:, mapping:)
 29:     imported_count = 0
 30:     failed_count = 0
 31: 
 32:     rows.each_with_index do |row, index|
 33:       company.transaction do
 34:         employee_attrs, user_attrs = mapped_attributes_from_row(row, mapping)
 35:         employee_attrs[:source_row] = index + 2
 36:         employee_attrs[:import_template] = import_template
 37: 
 38:         user = find_or_create_user!(employee_attrs: employee_attrs, user_attrs: user_attrs)
 39:         employee_attrs[:user] = user if user
 40: 
 41:         company.employees.create!(employee_attrs)
 42:         imported_count += 1
 43:       end
 44:     rescue ActiveRecord::RecordInvalid
 45:       failed_count += 1
 46:     end
 47: 
 48:     { imported_count: imported_count, failed_count: failed_count }
 49:   end
 50: 
 51:   private
 52: 
 53:   attr_reader :company, :import_template, :actor
 54: 
 55:   def mapped_attributes_from_row(row, mapping)
 56:     employee_attrs = {}
 57:     user_attrs = {}
 58: 
 59:     mapping.each do |column_index, field_name|
 60:       raw_value = row[column_index.to_i]
 61:       value = raw_value.is_a?(String) ? raw_value.strip : raw_value
 62:       next if value.blank?
 63: 
 64:       if USER_FIELDS.include?(field_name)
 65:         user_attrs[field_name.to_sym] = value
 66:         next
 67:       end
 68: 
 69:       next unless EMPLOYEE_FIELDS.include?(field_name)
 70: 
 71:       case field_name
 72:       when "salary"
 73:         employee_attrs[:salary] = value.to_s.delete(",").presence
 74:       when "payment_method"
 75:         employee_attrs[:payment_method] = normalize_payment_method(value)
 76:       when "mobile_money_provider"
 77:         employee_attrs[:mobile_money_provider] = normalize_mobile_money_provider(value)
 78:       when "account_type"
 79:         employee_attrs[:account_type] = normalize_account_type(value)
 80:       else
 81:         employee_attrs[field_name.to_sym] = value
 82:       end
 83:     end
 84: 
 85:     [ employee_attrs, user_attrs ]
 86:   end
 87: 
 88:   def find_or_create_user!(employee_attrs:, user_attrs:)
 89:     email = user_attrs[:email].to_s.downcase.presence
 90:     phone_number = user_attrs[:phone_number].to_s.presence
 91: 
 92:     user = if email
 93:       company.users.find_by(email: email)
 94:     elsif phone_number
 95:       company.users.find_by(phone_number: phone_number)
 96:     end
 97: 
 98:     return user if user
 99: 
100:     user = company.users.create!(
101:       first_name: employee_attrs[:first_name].presence || "Employee",
102:       last_name: employee_attrs[:last_name].presence || "User",
103:       email: email,
104:       phone_number: phone_number,
105:       status: :invited,
106:       onboarding_status: :unverified
107:     )
108: 
109:     user.send_verification!
110:     user
111:   end
112: 
113:   def normalize_payment_method(value)
114:     normalized = value.to_s.downcase.gsub(/\s+/, "_")
115:     return "bank" if normalized == "bank"
116:     return "mobile_money" if [ "mobile_money", "mm" ].include?(normalized)
117: 
118:     "cash"
119:   end
120: 
121:   def normalize_mobile_money_provider(value)
122:     normalized = value.to_s.downcase
123:     return "airtel" if normalized.include?("airtel")
124:     return "tigo" if normalized.include?("tigo") || normalized.include?("tnm") || normalized.include?("mpamba")
125: 
126:     nil
127:   end
128: 
129:   def normalize_account_type(value)
130:     normalized = value.to_s.downcase
131:     return "savings" if normalized.include?("saving")
132:     return "checking" if normalized.include?("checking") || normalized.include?("current")
133: 
134:     nil
135:   end
136: end
</file>

<file path="app/services/export_bank_schedule_service.rb">
 1: class ExportBankScheduleService
 2:   def initialize(user:, company:, pay_period:)
 3:     @user = user
 4:     @company = company
 5:     @pay_period = pay_period
 6:   end
 7: 
 8:   def call
 9:     raise "Unauthorized" unless user&.can?("export_bank_schedule")
10: 
11:     package = Axlsx::Package.new
12:     workbook = package.workbook
13: 
14:     workbook.add_worksheet(name: "Bank Schedule") do |sheet|
15:       sheet.add_row [ "Employee Code", "Name", "Bank", "Account", "Net Pay" ]
16: 
17:       if pay_period
18:         pay_period.payslips
19:                   .includes(:employee)
20:                   .where(employees: { payment_method: Employee.payment_methods[:bank] })
21:                   .references(:employees)
22:                   .find_each do |payslip|
23:           employee = payslip.employee
24:           next unless employee
25: 
26:           sheet.add_row [
27:             employee.employee_code,
28:             [ employee.first_name, employee.last_name ].compact.join(" ").strip,
29:             employee.bank_name,
30:             employee.bank_account_number,
31:             payslip.net.to_d.to_f
32:           ]
33:         end
34:       end
35:     end
36: 
37:     package.to_stream.read
38:   end
39: 
40:   private
41: 
42:   attr_reader :user, :company, :pay_period
43: end
</file>

