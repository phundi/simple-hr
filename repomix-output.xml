149:     params.require(:user).permit(:password, :password_confirmation, :two_factor_enabled, :two_factor_method)
150:   end
151: 
152:   def preference_params
153:     params.require(:preferences).permit(:email_notifications, :whatsapp_notifications, :language)
154:   end
155: 
156:   def save_preference(user, key, value)
157:     cfg = user.user_configs.find_or_initialize_by(key: key)
158:     cfg.data_type = key == "language" ? "string" : "boolean"
159:     cfg.value = key == "language" ? value.to_s : (ActiveModel::Type::Boolean.new.cast(value) ? "true" : "false")
160:     cfg.save!
161:   end
162: 
163:   def current_preferences_for(user)
164:     {
165:       email_notifications: user.preference("email_notifications", fallback: "true"),
166:       whatsapp_notifications: user.preference("whatsapp_notifications", fallback: "false"),
167:       language: user.preference("language", fallback: "en")
168:     }
169:   end
170: end
</file>

