 23:     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
 24: 
 25:     <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
 26:     <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>
 27: 
 28:     <style>
 29:       :root {
 30:         --tblr-primary: <%= current_company&.primary_color.presence || "#0d6efd" %>;
 31:       }
