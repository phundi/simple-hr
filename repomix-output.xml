115: 									<td class="fw-semibold"><%= config.key %></td>
116: 									<td>
117: 										<%= form_with model: config, url: company_config_path(config), method: :patch, class: "d-flex gap-2 align-items-center" do |f| %>
118: 											<%= f.text_field :value, value: config.value, class: "form-control form-control-sm" %>
119: 											<%= f.submit "Save", class: "btn btn-sm btn-primary" %>
120: 										<% end %>
121: 									</td>
122: 								</tr>
123: 							<% end %>
124: 						</tbody>
125: 					</table>
126: 				</div>
127: 			</div>
128: 		</div>
129: 	<% elsif @active_tab == "lists" %>
130: 		<div class="card shadow-sm border-0 rounded-3 mb-3">
131: 			<div class="card-body">
132: 				<h2 class="h6">Add List Item</h2>
133: 				<%= form_with url: create_property_company_configs_path, method: :post, class: "row g-2 align-items-end" do |f| %>
134: 					<div class="col-md-4">
135: 						<label for="company_property_property_key" class="form-label">List Type</label>
136: 						<%= select_tag "company_property[property_key]", options_for_select(CompanyProperty::PROPERTY_KEYS.map { |k| [k.humanize, k] }), class: "form-select", id: "company_property_property_key" %>
137: 					</div>
138: 					<div class="col-md-6">
139: 						<label for="company_property_value" class="form-label">Value</label>
140: 						<%= text_field_tag "company_property[value]", nil, class: "form-control", id: "company_property_value", placeholder: "e.g. Finance", required: true %>
141: 					</div>
142: 					<div class="col-md-2">
143: 						<%= submit_tag "Add", class: "btn btn-primary w-100" %>
144: 					</div>
145: 				<% end %>
146: 			</div>
147: 		</div>
148: 
149: 		<div class="row g-3">
150: 			<% CompanyProperty::PROPERTY_KEYS.each do |key| %>
151: 				<div class="col-12 col-lg-4">
152: 					<div class="card shadow-sm border-0 rounded-3 h-100">
153: 						<div class="card-body">
154: 							<h3 class="h6"><%= key.humanize %></h3>
