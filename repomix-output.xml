<file path="Dockerfile">
 1: # syntax=docker/dockerfile:1
 2: # check=error=true
 3: 
 4: # This Dockerfile is designed for production, not development. Use with Kamal or build'n'run by hand:
 5: # docker build -t hr .
 6: # docker run -d -p 80:80 -e RAILS_MASTER_KEY=<value from config/master.key> --name hr hr
 7: 
 8: # For a containerized dev environment, see Dev Containers: https://guides.rubyonrails.org/getting_started_with_devcontainer.html
 9: 
10: # Make sure RUBY_VERSION matches the Ruby version in .ruby-version
11: ARG RUBY_VERSION=4.0.0
12: FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base
13: 
14: # Rails app lives here
15: WORKDIR /rails
16: 
17: # Install base packages
18: RUN apt-get update -qq && \
19:     apt-get install --no-install-recommends -y curl default-mysql-client libjemalloc2 libvips && \
20:     ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
21:     rm -rf /var/lib/apt/lists /var/cache/apt/archives
22: 
23: # Set production environment variables and enable jemalloc for reduced memory usage and latency.
24: ENV RAILS_ENV="production" \
25:     BUNDLE_DEPLOYMENT="1" \
26:     BUNDLE_PATH="/usr/local/bundle" \
27:     BUNDLE_WITHOUT="development" \
28:     LD_PRELOAD="/usr/local/lib/libjemalloc.so"
29: 
30: # Throw-away build stage to reduce size of final image
31: FROM base AS build
32: 
33: # Install packages needed to build gems and node modules
34: RUN apt-get update -qq && \
35:     apt-get install --no-install-recommends -y build-essential default-libmysqlclient-dev git libvips libyaml-dev node-gyp pkg-config python-is-python3 && \
36:     rm -rf /var/lib/apt/lists /var/cache/apt/archives
37: 
38: # Install JavaScript dependencies
39: ARG NODE_VERSION=24.16.0
40: ARG YARN_VERSION=latest
41: ENV PATH=/usr/local/node/bin:$PATH
42: RUN curl -sL https://github.com/nodenv/node-build/archive/master.tar.gz | tar xz -C /tmp/ && \
43:     /tmp/node-build-master/bin/node-build "${NODE_VERSION}" /usr/local/node && \
44:     rm -rf /tmp/node-build-master
45: RUN corepack enable && yarn set version $YARN_VERSION
46: 
47: # Install application gems
48: COPY vendor/* ./vendor/
49: COPY Gemfile Gemfile.lock ./
50: 
51: RUN bundle install && \
52:     rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
53:     # -j 1 disable parallel compilation to avoid a QEMU bug: https://github.com/rails/bootsnap/issues/495
54:     bundle exec bootsnap precompile -j 1 --gemfile
55: 
56: # Install node modules
57: COPY package.json yarn.lock ./
58: RUN yarn install --immutable
59: 
60: # Copy application code
61: COPY . .
62: 
63: # Precompile bootsnap code for faster boot times.
64: # -j 1 disable parallel compilation to avoid a QEMU bug: https://github.com/rails/bootsnap/issues/495
65: RUN bundle exec bootsnap precompile -j 1 app/ lib/
66: 
67: # Precompiling assets for production without requiring secret RAILS_MASTER_KEY
68: RUN SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile
69: 
70: 
71: RUN rm -rf node_modules
72: 
73: 
74: # Final stage for app image
75: FROM base
76: 
77: # Run and own only the runtime files as a non-root user for security
78: RUN groupadd --system --gid 1000 rails && \
79:     useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash
80: USER 1000:1000
81: 
82: # Copy built artifacts: gems, application
83: COPY --chown=rails:rails --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
84: COPY --chown=rails:rails --from=build /rails /rails
85: 
86: # Entrypoint prepares the database.
87: ENTRYPOINT ["/rails/bin/docker-entrypoint"]
88: 
89: # Start server via Thruster by default, this can be overwritten at runtime
90: EXPOSE 80
91: CMD ["./bin/thrust", "./bin/rails", "server"]
</file>

