 20:         export_payslips
 21:         view_reports
 22:         manage_payroll_settings
 23:         manage_email_templates
 24:       ],
 25:       "hr" => %w[
 26:         manage_employees
 27:         view_payroll
 28:         create_payroll
 29:         export_payslips
 30:         view_reports
 31:       ],
 32:       "accountant" => %w[
 33:         view_payroll
 34:         process_payroll
 35:         export_bank_schedule
 36:         export_paye_schedule
 37:         view_reports
 38:       ]
 39:     }
 40:   end
 41: 
 42:   def load_defaults
 43:     return fallback_defaults unless File.exist?(DEFAULTS_PATH)
 44: 
 45:     yaml = YAML.safe_load_file(DEFAULTS_PATH) || {}
 46:     yaml.fetch("roles", {}).transform_values { |vals| Array(vals).map(&:to_s).uniq }
 47:   rescue Psych::Exception
 48:     fallback_defaults
 49:   end
 50: 
 51:   desc "Export current role permissions from a company to config/role_permission_defaults.yml"
 52:   task :export_defaults, [ :company_id ] => :environment do |_task, args|
 53:     company = if args[:company_id].present?
 54:       Company.find_by(id: args[:company_id])
 55:     else
 56:       Company.joins(:role_permissions)
 57:         .group("companies.id")
 58:         .order(Arel.sql("COUNT(role_permissions.id) DESC"))
 59:         .first
 60:     end
 61: 
 62:     if company.blank?
 63:       puts "No company with role permissions found."
 64:       next
 65:     end
 66: 
 67:     roles = User.roles.keys
 68:     grouped = company.role_permissions.where(role: roles).group_by(&:role)
 69:     exported = roles.index_with do |role|
 70:       grouped.fetch(role, []).select(&:enabled).map(&:permission_key).sort
 71:     end
 72: 
 73:     payload = { "roles" => exported }
 74:     File.write(DEFAULTS_PATH, payload.to_yaml)
 75: 
 76:     puts "Exported role permissions from company ##{company.id} (#{company.name}) to #{DEFAULTS_PATH}."
 77:   end
 78: 
 79:   desc "Seed default role permissions for all companies"
 80:   task seed_defaults: :environment do
 81:     defaults = load_defaults
 82: 
 83:     all_permissions = defaults.values.flatten.uniq
 84: 
 85:     Company.find_each do |company|
 86:       User.roles.keys.each do |role|
 87:         all_permissions.each do |permission_key|
 88:           enabled = defaults.fetch(role, []).include?(permission_key)
 89:           record = RolePermission.find_or_initialize_by(
 90:             company_id: company.id,
 91:             role: role,
 92:             permission_key: permission_key
 93:           )
 94:           record.enabled = enabled
 95:           record.save! if record.changed?
 96:         end
 97:       end
 98:     end
 99: 
100:     puts "Default role permissions seeded for #{Company.count} companies."
101:   end
102: end
</file>

<file path="public/javascripts/controllers/subdomain_controller.js">
 1: import { Controller } from "https://esm.sh/@hotwired/stimulus@3.2.2";
 2: 
 3: export default class extends Controller {
 4:   static targets = ["nameInput", "subdomainInput", "suggestions"];
 5: 
 6:   connect() {
 7:     this.timeoutId = null;
 8:   }
 9: 
10:   suggest() {
11:     clearTimeout(this.timeoutId);
12: 
13:     this.timeoutId = setTimeout(() => {
14:       const name = this.nameInputTarget.value.trim();
15: 
16:       if (!name) {
17:         this.renderNoSuggestions();
18:         return;
19:       }
20: 
21:       fetch(`/companies/suggest_subdomain?name=${encodeURIComponent(name)}`, {
22:         headers: { Accept: "application/json" }
23:       })
24:         .then((response) => response.json())
25:         .then((data) => {
26:           this.renderSuggestions(data.suggestions || []);
27:         })
28:         .catch(() => {
29:           this.renderNoSuggestions();
30:         });
31:     }, 500);
32:   }
33: 
34:   select(event) {
35:     const button = event.currentTarget;
36:     this.subdomainInputTarget.value = (button.dataset.value || "").trim();
37:   }
38: 
39:   renderSuggestions(suggestions) {
40:     this.suggestionsTarget.innerHTML = "";
41: 
42:     if (!suggestions.length) {
43:       this.renderNoSuggestions();
44:       return;
45:     }
46: 
47:     suggestions.slice(0, 3).forEach((suggestion) => {
48:       const button = document.createElement("button");
49:       button.type = "button";
50:       button.className = "btn btn-outline-primary btn-sm me-2 mb-2";
51:       button.dataset.value = suggestion;
52:       button.textContent = `https://${suggestion}.${this.mainDomain()}`;
53:       button.dataset.action = "click->subdomain#select";
54:       this.suggestionsTarget.appendChild(button);
55:     });
56:   }
57: 
58:   renderNoSuggestions() {
59:     this.suggestionsTarget.innerHTML = '<span class="text-muted small">Not available</span>';
60:   }
61: 
62:   mainDomain() {
63:     return this.element.dataset.mainDomain || "hr.com";
64:   }
65: }
</file>

