 41: 				  (function () {
 42: 				    function bindThemeColorSync() {
 43: 				      var form = document.getElementById("theme-color-form");
 44: 				      var colorInput = document.getElementById("company_primary_color");
 45: 				      var textInput = document.getElementById("company_primary_color_text");
 46: 				      var errorEl = document.getElementById("company_primary_color_error");
 47: 
 48: 				      if (!form || !colorInput || !textInput || form.dataset.themeBound === "true") {
 49: 				        return;
 50: 				      }
 51: 
 52: 				      form.dataset.themeBound = "true";
 53: 				      textInput.value = colorInput.value;
 54: 
 55: 				      function isValidHex(value) {
 56: 				        return /^#[0-9a-fA-F]{6}$/.test(value);
 57: 				      }
 58: 
 59: 				      function setValidityState(valid) {
 60: 				        textInput.classList.toggle("is-invalid", !valid);
 61: 				        if (errorEl) {
 62: 				          errorEl.style.display = valid ? "none" : "block";
 63: 				        }
 64: 				      }
 65: 
 66: 				      colorInput.addEventListener("input", function () {
 67: 				        textInput.value = colorInput.value;
 68: 				        setValidityState(true);
 69: 				      });
 70: 
 71: 				      textInput.addEventListener("input", function () {
 72: 				        var next = textInput.value.trim();
 73: 				        if (isValidHex(next)) {
 74: 				          colorInput.value = next;
 75: 				          setValidityState(true);
 76: 				        } else {
 77: 				          setValidityState(false);
 78: 				        }
 79: 				      });
 80: 
 81: 				      form.addEventListener("submit", function (event) {
 82: 				        var next = textInput.value.trim();
 83: 				        if (isValidHex(next)) {
 84: 				          colorInput.value = next;
 85: 				          setValidityState(true);
 86: 				        } else {
 87: 				          event.preventDefault();
 88: 				          setValidityState(false);
 89: 				        }
 90: 				      });
 91: 
 92: 				      setValidityState(isValidHex(textInput.value.trim()));
 93: 				    }
 94: 
 95: 				    document.addEventListener("DOMContentLoaded", bindThemeColorSync);
 96: 				    document.addEventListener("turbo:load", bindThemeColorSync);
 97: 				  })();
 98: 				</script>
 99: 			</div>
100: 		</div>
101: 
102: 		<div class="card shadow-sm border-0 rounded-3">
103: 			<div class="card-body">
104: 				<div class="table-responsive">
105: 					<table class="table align-middle mb-0">
106: 						<thead>
107: 							<tr>
108: 								<th>Key</th>
109: 								<th>Value</th>
110: 							</tr>
111: 						</thead>
112: 						<tbody>
113: 							<% @company_configs.each do |config| %>
