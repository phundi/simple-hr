<file path="app/views/companies/setup_step2.html.erb">
 1: <div class="container-xl py-4" style="max-width: 760px;">
 2:   <% default_color = @wizard_primary_color.presence || "#206bc4" %>
 3:   <% existing_logo_url = nil %>
 4:   <% if @wizard_logo_signed_id.present? %>
 5:     <% begin %>
 6:       <% existing_logo_url = url_for(ActiveStorage::Blob.find_signed(@wizard_logo_signed_id)) %>
 7:     <% rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound %>
 8:       <% existing_logo_url = nil %>
 9:     <% end %>
10:   <% end %>
11: 
12:   <div class="card" data-controller="logo-preview">
13:     <div class="card-header">
14:       <h3 class="card-title mb-0">Branding Setup</h3>
15:     </div>
16: 
17:     <%= form_with url: setup_step2_company_path(params[:id]), method: :post, local: true, scope: :company, html: { multipart: true } do |f| %>
18:       <div class="card-body">
19:         <%= f.hidden_field :logo_signed_id, value: @wizard_logo_signed_id %>
20: 
21:         <div class="mb-3">
22:           <%= f.label :logo, "Company Logo", class: "form-label" %>
23:           <%= f.file_field :logo,
24:               class: "form-control",
25:               accept: ".jpg,.jpeg,.png,image/jpeg,image/png",
26:               data: { action: "change->logo-preview#preview", logo_preview_target: "input" } %>
27:           <div class="form-text">Accepted formats: JPG, PNG.</div>
28:         </div>
29: 
30:         <div class="mb-4">
31:           <div class="border rounded p-3 d-inline-flex align-items-center justify-content-center" style="width: 180px; height: 140px; background: var(--tblr-bg-surface-secondary);">
32:             <img
33:               data-logo-preview-target="image"
34:               src="<%= existing_logo_url.to_s %>"
35:               alt="Logo preview"
36:               class="img-fluid <%= existing_logo_url.present? ? "" : "d-none" %>"
37:               style="max-height: 120px;"
38:             >
39:             <span data-logo-preview-target="placeholder" class="text-muted small <%= existing_logo_url.present? ? "d-none" : "" %>">No logo selected</span>
40:           </div>
41:         </div>
42: 
43:         <div class="mb-3">
44:           <%= f.label :primary_color, "Primary Color", class: "form-label" %>
45:           <%= f.color_field :primary_color, value: default_color, class: "form-control form-control-color", style: "width: 4rem;" %>
46:           <div class="form-text">This color will be used for buttons and theme</div>
47:         </div>
48:       </div>
49: 
50:       <div class="card-footer d-flex justify-content-between">
51:         <%= link_to "Cancel", cancel_company_setup_path, class: "btn btn-outline-secondary", data: { turbo_method: :post, turbo_confirm: "Are you sure? All progress will be lost." } %>
52:         <%= submit_tag "Continue", class: "btn btn-primary" %>
53:       </div>
54:     <% end %>
55:   </div>
56: </div>
57: 
58: <script type="module">
59:   import { Application, Controller } from "https://esm.sh/@hotwired/stimulus@3.2.2";
60: 
61:   if (!window.companySetupStimulusApp) {
62:     window.companySetupStimulusApp = Application.start();
63:   }
64: 
65:   class LogoPreviewController extends Controller {
66:     static targets = ["input", "image", "placeholder"];
67: 
68:     preview(event) {
69:       const file = event.target.files && event.target.files[0];
70:       if (!file) return;
71: 
72:       const validTypes = ["image/jpeg", "image/png"];
73:       if (!validTypes.includes(file.type)) {
74:         this.inputTarget.value = "";
75:         this.showPlaceholder();
76:         return;
77:       }
78: 
79:       const reader = new FileReader();
80:       reader.onload = (e) => {
81:         this.imageTarget.src = e.target.result;
82:         this.imageTarget.classList.remove("d-none");
83:         this.placeholderTarget.classList.add("d-none");
84:       };
85:       reader.readAsDataURL(file);
86:     }
87: 
88:     showPlaceholder() {
89:       this.imageTarget.src = "";
90:       this.imageTarget.classList.add("d-none");
91:       this.placeholderTarget.classList.remove("d-none");
92:     }
93:   }
94: 
95:   if (!window.companySetupStimulusRegistered) {
96:     window.companySetupStimulusApp.register("logo-preview", LogoPreviewController);
97:     window.companySetupStimulusRegistered = true;
98:   }
99: </script>
</file>

