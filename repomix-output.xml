 6:   <% active_tab = params[:tab].presence_in(["profile", "security", "preferences"]) || "profile" %>
 7: 
 8:   <ul class="nav nav-tabs mb-3">
 9:     <li class="nav-item"><%= link_to "Profile", account_users_path(tab: "profile"), class: "nav-link #{active_tab == "profile" ? "active" : ""}" %></li>
